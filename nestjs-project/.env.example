# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# Test database (integration + e2e)
# Integration and e2e tests MUST NOT be run without setting both variables
# below in your local .env. The test harness refuses to connect otherwise.
# DB_TEST_NAME must end with "_test" and is recreated (dropped) on every run.
DB_TEST_NAME=streamtube_test
# PostgreSQL system_identifier of the server allowed to host the test DB.
# Filled in automatically by the setup script when empty. Manually:
#   docker compose exec db psql -U streamtube -d streamtube -tAc "SELECT system_identifier FROM pg_control_system()"
DB_TEST_SERVER_ID=

# JWT - left empty on purpose: the setup script generates 32 random bytes for
# each one (and replaces missing, public, weak or identical values in an
# existing .env, keeping valid ones). The API refuses to start with a missing
# or placeholder secret, one shorter than 32 characters, one with fewer than
# 8 distinct characters, or the same value for both.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
# Bare address: angle brackets are not valid in a Compose/dotenv .env value
MAIL_FROM=noreply@streamtube.com

# Object storage (MinIO, phase 03) — non-secret settings only.
# Credentials NEVER go in this file: it is bind-mounted into the API and worker
# containers. The setup script (../scripts/setup.sh or ..\scripts\setup.ps1)
# generates them in <repo>/.local/secrets/ (git-ignored, outside every mount):
#   minio.env        MINIO_ROOT_USER, MINIO_ROOT_PASSWORD           -> minio only
#   api.env          S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (API),
#                    S3_DELIVERY_ACCESS_KEY_ID, S3_DELIVERY_SECRET_ACCESS_KEY -> nestjs-api
#   worker.env       S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (worker) -> worker
#   test-api.env /   S3_TEST_API_*, S3_TEST_WORKER_*, S3_TEST_DELIVERY_*
#   test-worker.env                                -> ephemeral test-api / test-worker
#   provision.env    root + every identity          -> provisioning container
#   maintenance.env  S3_TEST_MAINTENANCE_*          -> maintenance container
# The API and the worker refuse to start if MINIO_ROOT_* or S3_TEST_MAINTENANCE_*
# reach them; the tests refuse root, production and maintenance credentials.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3001
# The API uses the internal endpoint for storage calls and the public one only to sign URLs for clients
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true
# Test-only bucket (must end with -test); created by provisioning, never emptied by the suites
S3_TEST_BUCKET=streamtube-videos-test

# Uploads (phase 03)
MAX_UPLOAD_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=67108864
UPLOAD_EXPIRY_HOURS=24
UPLOAD_PART_PRESIGN_TTL_SECONDS=900
PLAYBACK_PRESIGN_TTL_SECONDS=3600
DOWNLOAD_PRESIGN_TTL_SECONDS=900
COMPLETING_STALE_MINUTES=15
MAX_ACTIVE_UPLOADS_PER_OWNER=3
MAX_PENDING_UPLOAD_BYTES_PER_OWNER=21474836480

# Media worker (phase 03); PROCESSING_INPUT_PRESIGN_TTL_SECONDS must be greater than WORKER_JOB_TIMEOUT_SECONDS
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_SECONDS=1800
PROCESSING_INPUT_PRESIGN_TTL_SECONDS=3600
MEDIA_PROBE_TIMEOUT_SECONDS=120
MAX_VIDEO_DURATION_SECONDS=14400

# Job queue (pg-boss, phase 03); the test schema must end with _test and is reset by the test harness
PGBOSS_SCHEMA=pgboss
PGBOSS_TEST_SCHEMA=pgboss_test
