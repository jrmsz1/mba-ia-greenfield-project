    "/videos": {
      "post": {
        "description": "Creates the private draft and its S3 multipart upload. Replaying the same Idempotency-Key with the same payload returns the same video (200).",
        "operationId": "VideosController_start",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "1..128 printable ASCII characters, unique per channel",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartUploadDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartUploadResponseDto"
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR or UPLOAD_SIZE_EXCEEDED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "CHANNEL_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_KEY_CONFLICT or UPLOAD_START_IN_PROGRESS (Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "ACTIVE_UPLOAD_LIMIT_EXCEEDED, PENDING_UPLOAD_QUOTA_EXCEEDED or UPLOAD_START_RATE_EXCEEDED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE (Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
