    "/videos/{id}/download-url": {
      "get": {
        "description": "Owner-only, ready videos only. The storage answers with Content-Disposition: attachment and the sanitized original filename (RFC 6266). Shares a 60 URLs/hour window with playback-url.",
        "operationId": "VideosController_downloadUrl",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
