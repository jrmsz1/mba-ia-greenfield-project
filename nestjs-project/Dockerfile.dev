# Node.js 26 LTS ("Lithium"), pinned by tag and digest (phase 03: pg-boss 12 requires Node >= 22.12)
FROM node:26.13.1-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc

RUN apt update && apt install -y procps curl

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 